# App gate (shared password for the UI)
APP_PASSWORD=change-me
# Cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# Digital Banking API
client_id=
client_secret=
x-api-key=
# Optional override (default: https://qa-api.firsthorizon.com)
# AUTH_DIGITAL_BANKING_API_BASE_URL=https://qa-api.firsthorizon.com
# grant_type=client_credentials

# Transmit Admin API (dev and tst share *_TST today)
TRANSMIT_CLIENT_ID_TST=
TRANSMIT_CLIENT_SECRET_TST=
# Optional aliases if you prefer these names:
# TRANSMIT_CLIENT_ID=
# TRANSMIT_CLIENT_SECRET=
# TRANSMIT_ADMIN_CLIENT_ID=
# TRANSMIT_ADMIN_CLIENT_SECRET=
# Optional override (default: https://api.transmitsecurity.io)
# TRANSMIT_ADMIN_API_BASE_URL=https://api.transmitsecurity.io

# Vercel Blob — set automatically when you link a Blob store in the Vercel dashboard
# BLOB_READ_WRITE_TOKEN=
